<UserControl x:Class="SysMarkModerno.Views.EmailSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SysMarkModerno.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="400">
    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Settings" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="CONFIGURACIÓN CORREO" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:ColorZone>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16" DataContext="{Binding EmailConfig}">
                <TextBlock Text="Servidor SMTP" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox materialDesign:HintAssist.Hint="smtp.ejemplo.com"
                         Text="{Binding SmtpServer, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,16"/>

                <TextBox materialDesign:HintAssist.Hint="Puerto (ej. 587, 25, 465)"
                         Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,16"/>

                <CheckBox Content="Usar SSL/TLS"
                          IsChecked="{Binding UseSsl}"
                          Margin="0,0,0,16"/>

                <Separator Margin="0,8,0,16"/>

                <TextBlock Text="Remitente" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox materialDesign:HintAssist.Hint="Nombre que aparecerá"
                         Text="{Binding FromName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,16"/>

                <TextBox materialDesign:HintAssist.Hint="correo@ejemplo.com"
                         Text="{Binding FromEmail, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,16"/>

                <Separator Margin="0,8,0,16"/>

                <TextBlock Text="Autenticación" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox materialDesign:HintAssist.Hint="Usuario/Correo"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,16"/>

                <PasswordBox materialDesign:HintAssist.Hint="Contraseña"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             local:PasswordBoxAssistant.BindPassword="True"
                             local:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>
                
                <TextBlock Text="Nota: Los cambios afectarán a todos los correos enviados por el sistema." 
                           FontStyle="Italic" Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <Button Content="CANCELAR"
                    Command="{Binding ToggleSettingsDrawerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,8,0"/>
            <Button Content="GUARDAR"
                    Command="{Binding GuardarConfiguracionEmailCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
