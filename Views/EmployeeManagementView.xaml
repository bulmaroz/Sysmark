<UserControl x:Class="SysMarkModerno.Views.EmployeeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SysMarkModerno.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="400"
             Background="{DynamicResource MaterialDesignPaper}"
             MinWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" Background="#FF335EF4">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding DataContext.ToggleEmployeeDrawerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Foreground="White">
                    <materialDesign:PackIcon Kind="ArrowLeft"/>
                </Button>
                <TextBlock Text="Gestión de Empleados" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Margin="12,0,0,0" Foreground="White"/>
            </StackPanel>
        </materialDesign:ColorZone>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <!-- Lista de Empleados -->
                <TextBlock Text="Lista de Empleados" FontWeight="Bold" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding Empleados}" 
                         SelectedItem="{Binding EmpleadoSeleccionado}"
                         Height="180"
                         Style="{StaticResource MaterialDesignListBox}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding NombreDeMuestra}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding EstatusDescripcion}" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Separator Margin="0,16"/>

                <!-- Formulario -->
                <TextBlock Text="Detalles del Empleado" FontWeight="Bold" Margin="0,0,0,16"/>
                
                <TextBox materialDesign:HintAssist.Hint="Nombre(s) *"
                         Text="{Binding EmpleadoSeleccionado.NombreCompleto, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,12"/>

                <TextBox materialDesign:HintAssist.Hint="Apellido Paterno *"
                         Text="{Binding EmpleadoSeleccionado.ApellidoPaterno, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,12"/>

                <TextBox materialDesign:HintAssist.Hint="Apellido Materno"
                         Text="{Binding EmpleadoSeleccionado.ApellidoMaterno, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,12"/>

                <TextBox materialDesign:HintAssist.Hint="Correo Electrónico"
                         Text="{Binding EmpleadoSeleccionado.CorreoElectronico, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,12"/>

                <ComboBox materialDesign:HintAssist.Hint="Estatus"
                          ItemsSource="{Binding ListaEstatus}"
                          DisplayMemberPath="Descripcion"
                          SelectedValuePath="IdEstatus"
                          SelectedValue="{Binding EmpleadoSeleccionado.IdEstatus}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,16"/>

                <ProgressBar Margin="0,8,0,0"
                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0"
                             IsIndeterminate="True"
                             Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,24">
            <Button Content="NUEVO" 
                    Command="{Binding NuevoEmpleadoCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#FF335EF4"
                    FontWeight="Bold"
                    Margin="0,0,12,0"/>
            <Button Content="GUARDAR" 
                    Command="{Binding GuardarCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    Margin="0,0,12,0"/>
            <Button Content="ELIMINAR" 
                    Command="{Binding EliminarCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#F44336"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>
