<Window x:Class="SysMarkModerno.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:SysMarkModerno.Helpers"
        xmlns:views="clr-namespace:SysMarkModerno.Views"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Title="SEGUIMIENTO DE PROSPECTOS A CLIENTES" 
        Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:ThemeIconConverter x:Key="ThemeIconConverter"/>
    </Window.Resources>

    <materialDesign:DialogHost>
        <materialDesign:DrawerHost IsRightDrawerOpen="{Binding IsEmployeeDrawerOpen}" IsLeftDrawerOpen="{Binding IsSettingsDrawerOpen}">
            <materialDesign:DrawerHost.RightDrawerContent>
                <views:EmployeeManagementView DataContext="{Binding EmployeeViewModel}" Width="420"/>
            </materialDesign:DrawerHost.RightDrawerContent>
            <materialDesign:DrawerHost.LeftDrawerContent>
                <views:EmailSettingsView Width="400" />
            </materialDesign:DrawerHost.LeftDrawerContent>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header / Toolbar -->
            <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16" 
                                      materialDesign:ElevationAssist.Elevation="Dp4" Background="#FF335EF4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartLine" Width="32" Height="32" 
                                                VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="RDMS Soluciones Empresariales " FontSize="24" FontWeight="Bold" 
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button ToolTip="Ver Llamadas Próximas"
                                Command="{Binding VerLlamadasProximasCommand}"
                                Margin="0,0,16,0"
                                Style="{StaticResource MaterialDesignRaisedSecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LLAMADAS" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button ToolTip="Ver Seguimientos Pendientes"
                                Command="{Binding VerSeguimientosProximosCommand}"
                                Margin="0,0,16,0"
                                Style="{StaticResource MaterialDesignRaisedSecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarCheck" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SEGUIMIENTOS" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button ToolTip="Gestión de Empleados"
                                Command="{Binding ToggleEmployeeDrawerCommand}"
                                Margin="0,0,16,0"
                                Style="{StaticResource MaterialDesignRaisedSecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="EMPLEADOS" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Recargar Datos"
                                Command="{Binding CargarDatosCommand}"
                                Foreground="White"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Refresh"/>
                        </Button>

                        <Button ToolTip="Cambiar Tema"
                                Command="{Binding ToggleThemeCommand}"
                                Foreground="White"
                                Margin="0,0,16,0"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="{Binding IsDarkMode, Converter={StaticResource ThemeIconConverter}}"/>
                        </Button>

                        <Button ToolTip="Configuración Email"
                                Command="{Binding ToggleSettingsDrawerCommand}"
                                Foreground="White"
                                Margin="0,0,16,0"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="Settings"/>
                        </Button>

                        <TextBlock VerticalAlignment="Center">
                            <Run Text="Total: "/>
                            <Run Text="{Binding TotalRegistros}" FontWeight="Bold"/>
                            <Run Text=" | Con Llamada: "/>
                            <Run Text="{Binding RegistrosConLlamada}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </materialDesign:ColorZone>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Panel Izquierdo - Lista y Búsqueda -->
                <materialDesign:Card Grid.Column="0" Margin="8" 
                                    materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Búsqueda -->
                        <StackPanel Grid.Row="0" Margin="16">
                            <TextBox materialDesign:HintAssist.Hint="Buscar empresa, contacto, email..."
                                    Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Margin="0,0,0,12">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding BuscarCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <!-- Filtros -->
                            <StackPanel>
                                <ComboBox materialDesign:HintAssist.Hint="Filtrar por Estatus"
                                         ItemsSource="{Binding ListaEstatus}"
                                         SelectedItem="{Binding EstatusFiltro}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,12"/>

                                <CheckBox Content="Solo con llamada programada"
                                         IsChecked="{Binding SoloConLlamada}"
                                         Margin="0,0,0,12"/>

                                <Button Content="LIMPIAR FILTROS" 
        Command="{Binding LimpiarFiltrosCommand}"
        Style="{StaticResource MaterialDesignOutlinedButton}" 
        Background="#FF335EF4"
        Foreground="White"
        BorderBrush="#FF335EF4"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Separador -->
                        <Separator Grid.Row="1"/>

                        <!-- Lista de Registros -->
                        <ListView Grid.Row="2" 
                                 ItemsSource="{Binding RegistrosFiltrados}"
                                 SelectedItem="{Binding RegistroSeleccionado}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}"
                                           Padding="8" Margin="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Empresa}" 
                                                          FontWeight="Bold" 
                                                          FontSize="16"
                                                          TextTrimming="CharacterEllipsis"/>
                                                
                                                <TextBlock Margin="0,4,0,0">
                                                    <Run Text="📞"/>
                                                    <Run Text="{Binding Contacto}"/>
                                                </TextBlock>
                                                
                                                <TextBlock Margin="0,2,0,0" Opacity="0.7">
                                                    <Run Text="📍"/>
                                                    <Run Text="{Binding Ciudad}"/>
                                                    <Run Text=", "/>
                                                    <Run Text="{Binding Estado}"/>
                                                </TextBlock>

                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Background="{Binding EstatusColor}" 
                                                           CornerRadius="3" Padding="6,2">
                                                        <TextBlock Text="{Binding Estatus}" 
                                                                  Foreground="White" 
                                                                  FontSize="11"/>
                                                    </Border>

                                                    <materialDesign:PackIcon Kind="Bell" 
                                                                            Width="16" Height="16"
                                                                            Margin="8,0,0,0"
                                                                            Foreground="Orange"
                                                                            Visibility="{Binding TieneLlamada, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <materialDesign:PackIcon Grid.Column="1" 
                                                                    Kind="ChevronRight" 
                                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </materialDesign:Card>

                <!-- Panel Derecho - Detalles y Formulario -->
                <materialDesign:Card Grid.Column="1" Margin="8,8,8,8"
                                    materialDesign:ElevationAssist.Elevation="Dp2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24" DataContext="{Binding RegistroSeleccionado}">
                            
                            <!-- Botones de Acción -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Button Content="NUEVO" 
                                       Command="{Binding DataContext.NuevoRegistroCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource MaterialDesignRaisedButton}"
                                       Margin="0,0,12,0">
                                    <Button.CommandParameter>
                                        <materialDesign:PackIcon Kind="Plus"/>
                                    </Button.CommandParameter>
                                </Button>

                                <Button Content="GUARDAR" 
                                       Command="{Binding DataContext.GuardarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource MaterialDesignRaisedButton}"
                                       Background="#4CAF50"
                                       Margin="0,0,12,0">
                                    <Button.CommandParameter>
                                        <materialDesign:PackIcon Kind="ContentSave"/>
                                    </Button.CommandParameter>
                                </Button>

                                <Button Content="ELIMINAR" 
                                       Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource MaterialDesignRaisedButton}"
                                       Background="#F44336">
                                    <Button.CommandParameter>
                                        <materialDesign:PackIcon Kind="Delete"/>
                                    </Button.CommandParameter>
                                </Button>
                            </StackPanel>

                            <!-- Datos Principales -->
                            <TextBlock Text="Datos Principales" 
                                      FontSize="18" FontWeight="Bold" 
                                      Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Grid.Column="0"
                                        materialDesign:HintAssist.Hint="Nombre de la Empresa *"
                                        Text="{Binding Empresa, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="0" Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Página Web"
                                        Text="{Binding PaginaWeb, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="1" Grid.Column="0"
                                        materialDesign:HintAssist.Hint="ERP que manejan"
                                        Text="{Binding ErpQueManeja, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="1" Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Giro"
                                        Text="{Binding Giro, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="2" Grid.Column="0"
                                        materialDesign:HintAssist.Hint="Estado"
                                        Text="{Binding Estado, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="2" Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Ciudad"
                                        Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                        materialDesign:HintAssist.Hint="Dirección"
                                        Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="4" Grid.Column="0"
                                        materialDesign:HintAssist.Hint="Código Postal"
                                        Text="{Binding CodigoPostal, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <ComboBox Grid.Row="4" Grid.Column="2"
                                         materialDesign:HintAssist.Hint="Estatus"
                                         ItemsSource="{Binding DataContext.ListaEstatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                         SelectedItem="{Binding Estatus}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16"/>
                            </Grid>

                            <!-- Contacto Principal -->
                            <TextBlock Text="Contacto Principal" 
                                      FontSize="18" FontWeight="Bold" 
                                      Margin="0,16,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Grid.Column="0"
                                        materialDesign:HintAssist.Hint="Nombre del Contacto"
                                        Text="{Binding Contacto, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="0" Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Puesto"
                                        Text="{Binding Puesto, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="1" Grid.Column="0"
                                        materialDesign:HintAssist.Hint="Teléfono"
                                        Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="1" Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Extensión"
                                        Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="2" Grid.Column="0"
                                        materialDesign:HintAssist.Hint="Email"
                                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="2" Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Celular"
                                        Text="{Binding Celular, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>
                            </Grid>

                            <!-- Contacto Secundario -->
                            <TextBlock Text="Contacto Secundario" 
                                      FontSize="18" FontWeight="Bold" 
                                      Margin="0,16,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Grid.Column="0"
                                        materialDesign:HintAssist.Hint="Nombre del Contacto 2"
                                        Text="{Binding Contacto2, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="0" Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Puesto 2"
                                        Text="{Binding Puesto2, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="1" Grid.Column="0"
                                        materialDesign:HintAssist.Hint="Teléfono 2"
                                        Text="{Binding Telefono2, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="1" Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Celular 2"
                                        Text="{Binding CelularContacto2, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                        materialDesign:HintAssist.Hint="Email 2"
                                        Text="{Binding Email2, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>
                            </Grid>

                            <!-- Datos del Proyecto -->
                            <TextBlock Text="Datos del Proyecto" 
                                      FontSize="18" FontWeight="Bold" 
                                      Margin="0,16,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DatePicker Grid.Row="0" Grid.Column="0"
                                           materialDesign:HintAssist.Hint="Fecha del Contacto"
                                           SelectedDate="{Binding FechaContacto}"
                                           Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                           Margin="0,0,0,16"/>

                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <CheckBox Content="Agendar llamada"
                                                  IsChecked="{Binding TieneLlamada}"
                                                  Margin="0,0,16,0">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Foreground" Value="Green"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        
                                        <DatePicker materialDesign:HintAssist.Hint="Próxima Llamada"
                                                   SelectedDate="{Binding ProximaLlamada}"
                                                   Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                                   IsEnabled="{Binding TieneLlamada}"
                                                   Margin="0,0,16,0"/>

                                        <materialDesign:TimePicker materialDesign:HintAssist.Hint="Hora"
                                                    SelectedTime="{Binding ProximaLlamada}"
                                                    Style="{StaticResource MaterialDesignOutlinedTimePicker}"
                                                    IsEnabled="{Binding TieneLlamada}"
                                                    Margin="0,0,16,0"/>

                                        <materialDesign:PopupBox StaysOpen="True">
                                            <materialDesign:PopupBox.ToggleContent>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AccountMultiplePlus" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Contactos Extras" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </materialDesign:PopupBox.ToggleContent>
                                            
                                            <ScrollViewer MaxHeight="300" Width="250">
                                                <ItemsControl ItemsSource="{Binding DataContext.ListaContactosExtras, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Nombre}" 
                                                                      IsChecked="{Binding IsSelected}"
                                                                      Margin="10,5"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </materialDesign:PopupBox>
                                    </StackPanel>

                                    <!-- Seguimiento Interno Section -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <CheckBox Content="Seguimiento interno"
                                                  IsChecked="{Binding SeguimientoActivo}"
                                                  Margin="0,0,16,0">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Foreground" Value="Blue"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        
                                        <DatePicker materialDesign:HintAssist.Hint="Seguimiento"
                                                   SelectedDate="{Binding Seguimiento}"
                                                   Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                                   IsEnabled="{Binding SeguimientoActivo}"
                                                   Margin="0,0,16,0"/>

                                        <materialDesign:TimePicker materialDesign:HintAssist.Hint="Hora"
                                                    SelectedTime="{Binding Seguimiento}"
                                                    Style="{StaticResource MaterialDesignOutlinedTimePicker}"
                                                    IsEnabled="{Binding SeguimientoActivo}"
                                                    Margin="0,0,16,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <CheckBox Grid.Row="1" Grid.Column="0"
                                         Content="Proyecto Epicor"
                                         IsChecked="{Binding ProyectoEpicor}"
                                         Margin="0,0,0,16"/>

                                <CheckBox Grid.Row="1" Grid.Column="2"
                                         Content="Proyecto Skymes"
                                         IsChecked="{Binding ProyectoOpera}"
                                         Margin="0,0,0,16"/>

                                <ComboBox Grid.Row="2" Grid.Column="0"
                                         materialDesign:HintAssist.Hint="Ingresado Por"
                                         ItemsSource="{Binding DataContext.ListaEmpleados, RelativeSource={RelativeSource AncestorType=Window}}"
                                         SelectedItem="{Binding IngresadoPor}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16"/>

                                <TextBox Grid.Row="2" Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Cliente De"
                                        Text="{Binding ClienteDe, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                        materialDesign:HintAssist.Hint="Comentarios"
                                        Text="{Binding Comentarios, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto"
                                        MinLines="4"
                                        MaxLines="8"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </materialDesign:Card>
            </Grid>

            <!-- Loading Overlay -->
            <Grid Grid.RowSpan="2" 
                  Background="#80000000"
                  Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                Value="0"
                                IsIndeterminate="True"
                                Width="80" Height="80"/>
                    <TextBlock Text="Cargando..." 
                              Foreground="White" 
                              FontSize="18"
                              Margin="0,16,0,0"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
        </materialDesign:DrawerHost>
    </materialDesign:DialogHost>
</Window>
